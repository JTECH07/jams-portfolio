{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/index.php",
      "use": "vercel-php@0.9.0"
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/build/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/(.*\\.(ico|json|txt|js|css))$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
